{
  "ServerConfig": {
    "Address": "127.0.0.1",
    "Port": 8080,
    "BackLog": 100,
    "MiddlewareConfig": {
      "MaxControlDataSizeBytes": 3000000,
      "MaxHeaderSizeBytes": 15000,
      "MaxBodySizeBytes": 1000,
      "RequestReadTimeoutMS": 10000,
      "RequestExecutionTimeoutMS": 30000,
      "ConnectionIdleTimeoutMS": 120000,
      "HttpsRedirectionEnabled": true,
      "HstsMaxAge": 63072000,
      "HstsIncludeSubDomains": true,
      "HstsPreload": false,
      "SecurityMiddleware": {
        "XContentTypeOptions": true,
        "ReferrerPolicy": "strict-origin-when-cross-origin",
        "PermissionsPolicy": "camera=(), microphone=(), geolocation=()",
        "CrossOriginOpenerPolicy": "same-origin",
        "CrossOriginResourcePolicy": "same-origin",
        "CrossOriginEmbedderPolicy": "require-corp",
        "RemoveServerHeader": true
      },
      "SessionMiddleware": {
        "IdleTimeoutMinutes": 20,
        "AbsoluteTimeoutMinutes": 720
      }
    }
  }
}