{
  "ServerConfig": {
    "Address": "127.0.0.1",
    "Port": 8080,
    "BackLog": 100,
    "ReadTimeoutMS": 120000,
    "MiddlewareConfig": {
      "RequestLimitsMiddleware": {
        "MaxControlDataSizeBytes": 3000000,
        "MaxHeaderSizeBytes": 15000,
        "MaxBodySizeBytes": 3000000
      },
      "IpBlocklistMiddleware": {
        "BlockedIPs": [ "" ]
      },
      "ConnectionMiddleware": {
        "RequestExecutionTimeoutMS": 10000
      },
      "HttpsRedirectionMiddleware": {
        "IsEnabled": false
      },
      "HstsMiddleware": {
        "MaxAge": 63072000,
        "IncludeSubDomains": true,
        "Preload": false
      },
      "SecurityMiddleware": {
        "XContentTypeOptions": true,
        "ReferrerPolicy": "strict-origin-when-cross-origin",
        "PermissionsPolicy": "camera=(), microphone=(), geolocation=()",
        "CrossOriginOpenerPolicy": "same-origin",
        "CrossOriginResourcePolicy": "same-origin",
        "CrossOriginEmbedderPolicy": "require-corp",
        "RemoveServerHeader": true
      },
      "SessionMiddleware": {
        "IdleTimeoutMinutes": 20,
        "AbsoluteTimeoutMinutes": 720,
        "CookieSecure": false
      },
      "StaticFilesMiddleware": {
        "FileRootPath": ""
      },
      "SpaFallbackMiddleware": {
        "IndexPageRelativePath": ""
      },
      "CorsMiddleware": {
        "AllowedOrigins": [ "http://localhost:8081" ],
        "AllowCredentials": true,
        "ExposedHeaders": [ "X-Request-Id" ],
        "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
        "AllowedHeaders": [ "Authorization", "Content-Type", "X-CSRF-Token" ],
        "PreflightMaxAgeSeconds": 60
      }
    }
  }
}
